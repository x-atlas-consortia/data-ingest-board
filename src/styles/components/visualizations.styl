.c-visualizations
  container()
  &__dropdownContainer
    display flex
  &__columnDropdown
    border-bottom-right-radius 0
    border-top-right-radius 0
  &__chartDropdown
    border-bottom-left-radius 0
    border-top-left-radius 0
  &__itemCol
    display inline-block
    width 8px
    height 8px
    margin-right 5px
  &__tooltip
    background-color white
    border solid $col-gal-grey 1px
    position absolute
    border-radius 5px
    padding 5px
    z-index 1000
    font-size 12px
    width max-content
    transition left 0.1s ease-in
    &Wrap
      text-align left
  &__chart
    overflow-x auto
    position relative
    circle 
      cursor pointer
  &__miniCharts
    .c-visualizations__chart 
      overflow-x inherit
    svg 
      max-width 100%
      height auto