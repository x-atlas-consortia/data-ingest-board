.c-inbar 
  position relative
  display inline-block
  width 100%
  &__fill
    height 5px
    display inline-block
    vertical-align middle
    border-radius 2px
    background-color rgba(52, 152, 219, 0.85)
    transition width 0.3s ease
  &__text
    display inline-block
    position relative
    margin-left 5px